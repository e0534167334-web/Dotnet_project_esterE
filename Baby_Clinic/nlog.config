<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true">

  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <!-- CorrelationId מגיע מה-scope שנפתח ב-CorrelationIdMiddleware; מחוץ לבקשה הוא ריק -->
  <variable name="lineLayout"
            value="${longdate}|${level:uppercase=true:padding=-5}|${scopeproperty:CorrelationId:whenEmpty=-}|${logger:shortName=true}|${message}${onexception:inner=${newline}${exception:format=tostring}}" />

  <targets>
    <target xsi:type="File" name="file"
            fileName="${aspnet-appbasepath}/logs/babyclinic-${shortdate}.log"
            layout="${lineLayout}"
            encoding="utf-8"
            maxArchiveDays="14" />

    <target xsi:type="ColoredConsole" name="console" layout="${lineLayout}" />
  </targets>

  <rules>
    <!-- רעש של ה-framework: רק Warning ומעלה (חוץ מהודעות העלייה של השרת) -->
    <logger name="Microsoft.Hosting.Lifetime" minlevel="Info" writeTo="file,console" final="true" />
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />

    <!-- Debug רק בפיתוח: Diagnostics:MinLogLevel מוגדר ב-appsettings.Development.json -->
    <logger name="*" minlevel="${configsetting:item=Diagnostics.MinLogLevel:whenEmpty=Info}" writeTo="file,console" />
  </rules>
</nlog>
